    "Also show on hover": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カーソルを乗せたときにも表示"
          }
        }
      }
    },
    "An app with several icons is hidden as a whole.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数のアイコンを出すアプリは、まとめて隠れます。"
